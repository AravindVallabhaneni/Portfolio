# 1. LeetCode Integration
# The username queried by the /api/leetcode serverless function and frontend client
LEETCODE_USERNAME="TODO: LEETCODE_USERNAME"
VITE_LEETCODE_USERNAME="TODO: LEETCODE_USERNAME"

# 2. Contact Form (Formspree)
# Sign up at https://formspree.io, create a form, and paste the endpoint URL below:
