# 4. Analytics Flag
# Toggle privacy-friendly telemetry (Vercel Web Analytics or Plausible)
VITE_ENABLE_ANALYTICS=false

# 5. Canonical Site URL (Used for OpenGraph, Twitter Cards, and Sitemap)
VITE_SITE_URL="https://aravindvallabhaneni.dev"

